{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxyCast",
  "version": "1.0.0",
  "identifier": "com.voxycast.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxyCast",
        "width": 460,
        "height": 700,
        "minWidth": 460,
        "minHeight": 700,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQzYzMjZCRkZCODAwRjIKUldUeUFMai9hekxHY2RXMnM2ZTQxL1hQQnpOSUZKd2c5aEkyOHc3ZWg4WGN3NDVZZGVTRklkR0sK",
      "endpoints": [
        "https://github.com/BabyEvo/Voxycast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}